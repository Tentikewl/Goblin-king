{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "hidden": true,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tabs"
          },
          "size": {
            "px": 42
          },
          "background": "#0b0907e6",
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "court",
              "type": "block",
              "size": {
                "px": 445
              },
              "min": 300,
              "max": 700,
              "content": {
                "mod": "goblin-court"
              }
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "#00000000",
                  "border": {
                    "width": 0,
                    "color": "#00000000"
                  },
                  "focus": {
                    "width": 0,
                    "color": "#00000000"
                  },
                  "radius": 0,
                  "gap": 8,
                  "lone": true
                }
              },
              "size": {
                "weight": 1
              },
              "background": {
                "image": "mods/goblin-court/art/hall/torn-page.png",
                "fit": "cover"
              },
              "min": 360
            },
            {
              "id": "king-corner",
              "type": "block",
              "size": {
                "px": 237
              },
              "min": 150,
              "max": 420,
              "content": {
                "mod": "king-corner"
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 4
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "background": "#0b0907e6"
        }
      ],
      "resizable": false
    }
  ],
  "background": "#0f0d0a",
  "colors": {
    "background": "#0f0d0a"
  },
  "terminal_padding": [
    26,
    24
  ],
  "terminal_opacity": 0.0,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/goblin-king.png"
}